# Flask — production requires a strong random key (32+ chars); app refuses weak defaults
FLASK_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Production: false (enforces login + Stripe). Local smoke without paywall: true
TEST_MODE=false

# Supabase (new project only — never reuse Canada)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_AUTH_REDIRECT_URL=https://www.welcometotrades.com/auth/confirm

# Stripe — YOUR account only (do not reuse Remote Jobs Canada keys/prices)
# Webhook endpoint: https://www.welcometotrades.com/webhook
STRIPE_API_KEY=sk_live_your_wtt_key
STRIPE_PRODUCT_ID=prod_your_wtt_product
STRIPE_PRICE_WEEKLY=price_your_weekly
STRIPE_PRICE_MONTHLY=price_your_monthly
STRIPE_PRICE_YEARLY=price_your_yearly
STRIPE_PRICE_ID=price_your_yearly
STRIPE_WEBHOOK_SECRET=whsec_your_wtt_webhook_secret

# Contact form email delivery
# Contact form email delivery (Google Workspace / Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=roman@welcometotrades.com
SMTP_PASSWORD=your-gmail-app-password
CONTACT_EMAIL=roman@welcometotrades.com

# reCAPTCHA
RECAPTCHA_SITE_KEY=your-public-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# SEO (optional)
GA4_MEASUREMENT_ID=
CLARITY_PROJECT_ID=
GOOGLE_SITE_VERIFICATION=
CANONICAL_HOST=www.welcometotrades.com

# Job alert emails (Resend) — set on Railway cron service + web app for account toggle
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Welcome to Trades <jobs@welcometotrades.com>
CONTACT_FROM_EMAIL=Welcome to Trades <roman@welcometotrades.com>
# Contact form prefers Resend over SMTP (Railway blocks outbound SMTP from the web service).
JOB_ALERTS_LOOKBACK_HOURS=24
JOB_ALERTS_MAX_JOBS=15
# JOB_ALERTS_DRY_RUN=true

# Passwordless auth — redirect URL after user clicks the email link (must match Supabase Auth URL config)
# SUPABASE_AUTH_REDIRECT_URL=https://www.welcometotrades.com/auth/confirm

# Notes
# 1. In Supabase Dashboard → Authentication → URL Configuration, add your /auth/confirm URL to Redirect URLs.
# 2. Update the Magic Link email template to include the OTP code and a custom link, e.g.:
#    <p>Your sign-in code: <strong>{{ .Token }}</strong></p>
#    <p><a href="{{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email">Sign in</a></p>
#    Outlook/Hotmail users should use the 6-digit code on the sign-in page (link prefetch breaks magic links).
# 3. Use the anon key for auth and the service role key only on the backend.
# 4. If Gmail is used for SMTP, create an App Password and do not use your normal login password.
